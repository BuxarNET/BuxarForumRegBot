{
  "name": "phpBB",
  "domain": "phpbb.com",
  "engine": "phpbb",
  "detect": {
    "url_pattern": "profile.php?mode=register",
    "meta_tags": [
      {
        "name": "generator",
        "content": "phpBB"
      }
    ],
    "html_contains": [
      "phpbb"
    ]
  },
  "registration_page": {
    "url": [
      "/ucp.php?mode=register",
      "/profile.php?mode=regitser",
      "/haktiydj",
      "/tzcrveko"
    ],
    "form_selector": [
      "form#register",
      "#register",
      [
        "#agreement"
      ],
      [
        "#register"
      ],
      "#agreement",
      "form[action='./ucp.php?mode=register']",
      "#regformid"
    ]
  },
  "agree_step": {
    "checkboxes": [
      "input[name='agreed']",
      "input[name='notifypm']",
      "input[name='pstatus_notify']",
      "input[name='friend_notify']"
    ],
    "submit_button": []
  },
  "fields": {
    "username": [
      "input[name='username']",
      "#username",
      "#ufnid"
    ],
    "email": [
      "input[name='email']",
      "#email"
    ],
    "password": [
      "input[name='new_password']",
      "#new_password"
    ],
    "confirm_password": [
      "input[name='password_confirm']",
      "#password_confirm",
      "#psw2"
    ],
    "agree_checkbox": [
      "input[name='agreed']",
      "input[name='agreement']"
    ],
    "submit_button": [
      "input[type='submit'][name='submit']",
      "#agreed",
      "#submit",
      "#agreede",
      "input[name='submit']"
    ],
    "captcha_indicator": [],
    "lang": [
      "#lang"
    ],
    "tz_date": [
      "#tz_date"
    ],
    "timezone": [
      "#timezone_copy",
      "#tz_date"
    ],
    "username_label": [
      "Имя пользователя:",
      "ИMЯ:*\nПсевдоним для общения, длиной от 3 до 25 символов",
      "Имя пользователя (ник):"
    ],
    "email_label": [
      "Адрес email:",
      "Адрес e-mail:"
    ],
    "password_label": [
      "Пароль:"
    ],
    "confirm_password_label": [
      "Подтвердите новый пароль:",
      "Подтвердите пароль:*"
    ],
    "confirm_email": [
      "#email_confirm",
      "input[name='email_confirm']"
    ],
    "confirm_email_label": [
      "Подтвердите email:"
    ],
    "submit_button_label": [
      "Я соглашаюсь с этими условиями",
      "Отправить",
      "Я согласен с этими условиями",
      "Зарегистрироваться"
    ],
    "pf_family": [
      "#pf_family"
    ],
    "tz": [
      "select[name='tz']"
    ],
    "pf_real_name": [
      "input[name='pf_real_name']"
    ],
    "namep[1]": [
      "#inm1"
    ],
    "pf_fio": [
      "#pf_fio"
    ]
  },
  "custom_fields": [],
  "success_indicators": [
    "registration complete",
    "your account has been created",
    "account created",
    "check your email",
    "activation link",
    "confirmation email",
    "активировать",
    "подтвердите регистрацию",
    "спасибо за регистрацию",
    "регистрация завершена",
    "на вашу почту",
    "отправлено письмо",
    "проверьте email",
    "вам выслано письмо",
    "активационная ссылка",
    "завершена регистрация",
    "verify your email",
    "welcome",
    "thank you for registering",
    "учётная запись была создана"
  ],
  "error_indicators": [
    "username already exists",
    "email address is already registered",
    "already taken",
    "already exists",
    "уже зарегистрирован",
    "занято",
    "ошибка",
    "already registered",
    "username taken",
    "email already",
    "invalid username",
    "invalid email",
    "уже существует",
    "существует пользователь",
    "username already taken",
    "имя пользователя занято",
    "пользователь с таким именем",
    "извините, пользователь",
    "sorry, username",
    "taken",
    "exists",
    "406-ФЗ",
    "не допускается регистрация"
  ]
}